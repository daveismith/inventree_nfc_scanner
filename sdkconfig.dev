# Development overrides, on top of sdkconfig.defaults:
#
#   idf.py -B build-dev -DSDKCONFIG=build-dev/sdkconfig -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.dev" build
#
# (its own build directory and sdkconfig, so that the plain build stays the production one;
# see README "Build and flash")
#
# A unit built from sdkconfig.defaults alone has none of these.

# The board sends itself to ROM download mode after a run of crashes or when no host
# enumerates it, and the `debug` command exists. Not for a unit on a charger or out of reach.
CONFIG_APP_DEV_RECOVERY=y

# Opening the port at 1200 baud and closing it enters download mode: the flash hook's fallback
# when the protocol does not answer. Off in production, where any serial prober could trip it.
CONFIG_APP_USB_TOUCH_1200=y

# The plugin's local Docker instance is plain http. With this off, `net server` and `ota`
# refuse http:// URLs and a stored http:// URL leaves the link off.
CONFIG_APP_NET_ALLOW_HTTP=y

# The PN532's IRQ and reset pins, as in sdkconfig.defaults; repeated so the development unit
# keeps them whatever the defaults say.
CONFIG_APP_NFC_IRQ_GPIO=3
CONFIG_APP_NFC_RST_GPIO=-1
